VITE_API_BASE_URL=https://your-api-host/api
OPENAI_API_KEY=your-openai-api-key
OPENAI_OCR_MODEL=gpt-5.6-terra
PORT=8787
APP_BASE_PATH=/milk
VITE_BASE_PATH=/milk/
AUTH_SESSION_DAYS=30
# Set true only when the site is served over HTTPS.
AUTH_COOKIE_SECURE=false

# Excel Online / Microsoft Graph
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=organizations
GRAPH_WORKBOOK_URL=https://your-tenant.sharepoint.com/path/to/workbook.xlsx
GRAPH_SCOPES=Files.ReadWrite offline_access
EXCEL_GRAPH_TOKEN_CACHE=/persistent-secrets/.graph-token-cache.json
OCR_EXCEL_SHEET_NAME=Daily_Routes
OCR_EXCEL_TABLE_NAME=tblDailyRoutes
OCR_EXCEL_DEFAULT_MILK_CODE=MILK-COW
OCR_EXCEL_ANTIBIOTICS_STATUS=OK
