<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="167772160" />
      </requestFiltering>
    </security>
    <httpPlatform processPath="C:\Program Files\nodejs\node.exe"
                  arguments="server\index.js"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\milk-collection"
                  startupTimeLimit="90"
                  requestTimeout="00:15:00">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="APP_BASE_PATH" value="/milk" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
